// LCD Screen — Configuration
// Copy this file, rename it, and adjust settings to taste.
// Then update setup.jsx to #include your copy instead of this one.

var LcdScreenConfig = {
    // --- Source ---
    SOURCE_ITEM_NAME: null,          // Project item name to use as screen content.
                                      // null = use the selected footage item in the Project panel,
                                      // else the first footage item found.
    MASTER_COMP_NAME: "LCD Screen Master",
    WIDTH: 1920,
    HEIGHT: 1080,
    DURATION: 10,
    FRAME_RATE: 30,

    // --- Preset ---
    PRESET: "Static Default",        // Key into LcdScreenPresets (presets.jsxinc). "" = use the raw values below.

    // --- Panel: subpixel + scanlines ---
    SUBPIXEL_MODE: "stripe",         // "stripe" | "grille" | "dot"
    SUBPIXEL_PIXEL_SIZE: 6,          // px per LCD cell
    SUBPIXEL_AMOUNT: 55,             // 0-100
    SCANLINE_PITCH: 4,               // px between lines
    SCANLINE_AMOUNT: 30,             // 0-100
    SCANLINE_ROLL_BAR: false,

    // --- Panel: backlight ---
    BACKLIGHT_TINT_PRESET: "none",   // "warm" | "cool" | "green" | "none"
    BACKLIGHT_TINT_DENSITY: 25,      // 0-100
    BACKLIGHT_BLEED_CORNERS: ["topLeft", "bottomRight"],
    BACKLIGHT_BLEED_INTENSITY: 20,   // 0-100
    BACKLIGHT_MURA: 4,               // 0-100

    // --- Panel: viewing angle + glow ---
    VIEWING_ANGLE_AXIS: "horizontal",
    VIEWING_ANGLE_AMOUNT: 35,        // 0-100
    GLOW_THRESHOLD_PERCENT: 60,      // 0-100 (converted internally to Glow's 0-255 scripting range)
    GLOW_RADIUS: 15,
    GLOW_INTENSITY: 0.8,             // 0-4

    // --- Glass ---
    GLASS_DUST: 25,                  // 0-100
    GLASS_SMUDGE: 15,                // 0-100
    GLASS_SHEEN: 20,                 // 0-100
    GLASS_SWEEP: true,
    GLASS_SWEEP_SPEED: 6,            // seconds per pass

    // --- Vignette ---
    VIGNETTE_AMOUNT: 35,             // 0-100

    // --- Body ---
    BEZEL_ENABLED: true,
    BEZEL_WIDTH: 36,                 // px
    BEZEL_CORNER_RADIUS: 20,         // px
    BEZEL_COLOR: [0.07, 0.07, 0.08],
    AMBIENT_SPILL_ENABLED: true,
    AMBIENT_SPILL_OPACITY: 25,       // 0-100

    // --- Camera / lens (live — rig-linked, tweakable from the panel after build) ---
    CAMERA_DISTANCE: 1400,           // px
    CAMERA_ORBIT_DEG: 12,            // degrees, left/right around the screen
    CAMERA_TILT_DEG: 6,              // degrees, up/down around the screen
    CAMERA_ZOOM: 1800,               // px (camera focal length proxy)
    DEPTH_OF_FIELD: true,
    APERTURE: 40,
    AUTO_ZOOM: true,                 // baked at build time; re-run the panel's "Bake Auto Zoom" after changing camera controls
    AUTO_ZOOM_PADDING_PERCENT: 2,    // extra coverage beyond the frame edge, in percent

    // --- Procedural motion (keyframe-free, seeded wiggle — config-time only, rebuild to change) ---
    MOTION_TARGET_AMOUNT: 0,         // px, camera Point of Interest jitter
    MOTION_TARGET_SPEED: 0.15,       // Hz
    MOTION_ANGLE_AMOUNT: 0,          // degrees, camera Orientation jitter
    MOTION_ANGLE_SPEED: 0.1,
    MOTION_FOCUS_AMOUNT: 0,          // px, focus distance jitter
    MOTION_FOCUS_SPEED: 0.2,
    MOTION_SEED: 1,

    // --- Lens: final camera-pass stack (live — rig-linked) ---
    LENS_DISTORTION_AMOUNT: 12,      // -100 to 100
    LENS_CA_MODE: "subtle",          // "subtle" only here — the lens stack is an adjustment layer,
                                      // and "lens" mode duplicates its target, which would re-apply
                                      // distortion and grain to the whole composite once per copy.
    LENS_CA_AMOUNT: 25,              // 0-100
    LENS_GRAIN_AMOUNT: 6             // 0-100 (ADBE Noise amount, via addGrain)
};
