// LCD Screen - Oversampled 3D Scene and Live Camera

function buildSceneComp(panel, cfg) {
    var sceneComp = markLcdComp(
        app.project.items.addComp(
            "LCD_Scene",
            panel.width,
            panel.height,
            1,
            cfg.DURATION,
            cfg.FRAME_RATE
        )
    );
    try { sceneComp.bgColor = [0, 0, 0]; } catch (_) {}

    var panelLayer = sceneComp.layers.add(panel.comp);
    panelLayer.name = "LCD PANEL 3D";
    panelLayer.threeDLayer = true;
    panelLayer.property("Transform").property("Position")
        .setValue([sceneComp.width / 2, sceneComp.height / 2, 0]);

    return {
        comp: sceneComp,
        panelLayer: panelLayer,
        width: sceneComp.width,
        height: sceneComp.height
    };
}

function buildCameraRig(sceneComp, panelLayer, cfg) {
    if (!sceneComp || !panelLayer) {
        throw new Error("buildCameraRig: sceneComp and panelLayer are required.");
    }

    setStep("create live camera");
    var camera = addCamera(sceneComp, {
        name: "LCD Camera",
        zoom: cfg.CAMERA_ZOOM,
        depthOfField: cfg.DEPTH_OF_FIELD
    });
    var transform = camera.property("ADBE Transform Group");
    var cameraOptions = camera.property("ADBE Camera Options Group");
    var cx = sceneComp.width / 2 + cfg.TARGET_X;
    var cy = sceneComp.height / 2 + cfg.TARGET_Y;
    var orbitRad = cfg.CAMERA_ORBIT_DEG * Math.PI / 180;
    var tiltRad = cfg.CAMERA_TILT_DEG * Math.PI / 180;
    var distance = cfg.CAMERA_DISTANCE;

    transform.property("ADBE Position").setValue([
        cx + Math.sin(orbitRad) * distance,
        cy - Math.sin(tiltRad) * distance,
        -Math.cos(orbitRad) * Math.cos(tiltRad) * distance
    ]);
    transform.property("ADBE Anchor Point").setValue([cx, cy, 0]);
    try { transform.property("ADBE Rotate Z").setValue(cfg.CAMERA_ROLL_DEG); } catch (_) {}

    cameraOptions.property("ADBE Camera Focus Distance").setValue(distance + cfg.FOCUS_OFFSET);
    cameraOptions.property("ADBE Camera Aperture").setValue(cfg.APERTURE);
    cameraOptions.property("ADBE Camera Blur Level").setValue(100);

    return {
        camera: camera,
        transform: transform,
        camOpts: cameraOptions,
        panelLayer: panelLayer
    };
}

function buildMasterComp(scene, cfg) {
    var masterComp = markLcdComp(
        app.project.items.addComp(
            cfg.MASTER_COMP_NAME,
            cfg.WIDTH,
            cfg.HEIGHT,
            1,
            cfg.DURATION,
            cfg.FRAME_RATE
        )
    );
    try { masterComp.bgColor = [0, 0, 0]; } catch (_) {}

    var sceneLayer = masterComp.layers.add(scene.comp);
    sceneLayer.name = "CA GREEN";
    sceneLayer.property("Transform").property("Position")
        .setValue([masterComp.width / 2, masterComp.height / 2]);
    var baseFit = Math.min(masterComp.width / scene.width, masterComp.height / scene.height) * 100;
    sceneLayer.property("Transform").property("Scale").setValue([baseFit, baseFit]);

    return {
        comp: masterComp,
        sceneLayer: sceneLayer,
        baseFit: baseFit
    };
}
