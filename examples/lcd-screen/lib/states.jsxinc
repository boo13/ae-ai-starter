function getLcdStateSet(milestone) {
    var key = String(milestone || "").toLowerCase();
    var states = LcdScreenStateSets[key];
    if (!states) {
        throw new Error("Unknown LCD state milestone: " + milestone);
    }
    return states;
}

function getLcdPreviewFolder(entryFile) {
    if (!entryFile) {
        throw new Error("getLcdPreviewFolder: entryFile is required.");
    }
    var repoRoot = entryFile.parent.parent.parent;
    var previewDir = new Folder(String(repoRoot.fsName) + "/Scripts/runs/preview");
    if (!previewDir.exists && !previewDir.create()) {
        throw new Error("Could not create preview folder: " + previewDir.fsName);
    }
    return previewDir;
}

function _lcdStateControlProperty(rigNull, controlName) {
    var effect = null;
    try { effect = rigNull.property("ADBE Effect Parade").property(controlName); } catch (_) {}
    if (!effect) {
        throw new Error("LCD state control not found: " + controlName);
    }
    var prop = null;
    try { prop = effect.property(1); } catch (_) {}
    if (!prop || prop.propertyType !== PropertyType.PROPERTY) {
        throw new Error("LCD state control has no value property: " + controlName);
    }
    return prop;
}

function findLcdAutoExposureExtremes(masterComp, rigNull, exposureEffect) {
    if (!masterComp || !(masterComp instanceof CompItem)) {
        throw new Error("findLcdAutoExposureExtremes: masterComp must be a CompItem.");
    }
    if (!rigNull || !exposureEffect) {
        throw new Error("findLcdAutoExposureExtremes: rigNull and exposureEffect are required.");
    }

    var manualProp = _lcdStateControlProperty(rigNull, "COL Exposure");
    var autoProp = _lcdStateControlProperty(rigNull, "COL Auto Exposure");
    var exposureProp = exposureEffect.property("ADBE Exposure2-0003");
    var originalManual = manualProp.value;
    var originalAuto = autoProp.value;
    var targetLuminance = 0.18;
    var darkest = null;
    var brightest = null;
    var samples = [];
    var lastTime = Math.max(0, masterComp.duration - masterComp.frameDuration);
    var interval = 0.5;

    try {
        manualProp.setValue(0);
        autoProp.setValue(1);

        var t = 0;
        while (t <= lastTime + 0.0001) {
            var correction = Number(exposureProp.valueAtTime(t, false));
            if (!isFinite(correction)) {
                throw new Error("Auto Exposure returned a non-finite value at " + t + " seconds.");
            }
            var sample = {
                time: t,
                correctionStops: correction,
                estimatedLuminance: targetLuminance / Math.pow(2, correction)
            };
            samples.push(sample);
            if (!darkest || correction > darkest.correctionStops) darkest = sample;
            if (!brightest || correction < brightest.correctionStops) brightest = sample;
            t += interval;
        }

        if (samples.length && samples[samples.length - 1].time < lastTime - 0.0001) {
            var lastCorrection = Number(exposureProp.valueAtTime(lastTime, false));
            if (!isFinite(lastCorrection)) {
                throw new Error("Auto Exposure returned a non-finite value at the final frame.");
            }
            var lastSample = {
                time: lastTime,
                correctionStops: lastCorrection,
                estimatedLuminance: targetLuminance / Math.pow(2, lastCorrection)
            };
            samples.push(lastSample);
            if (!darkest || lastCorrection > darkest.correctionStops) darkest = lastSample;
            if (!brightest || lastCorrection < brightest.correctionStops) brightest = lastSample;
        }
    } finally {
        try { manualProp.setValue(originalManual); } catch (_) {}
        try { autoProp.setValue(originalAuto); } catch (_) {}
    }

    var report = {
        targetLuminance: targetLuminance,
        sampleInterval: interval,
        sampleCount: samples.length,
        darkest: darkest,
        brightest: brightest,
        compensationRange: darkest && brightest
            ? darkest.correctionStops - brightest.correctionStops
            : 0
    };
    setResultData("lcdAutoExposureProbe", report);
    return report;
}

function setLcdAutoExposureStateTimes(states, extremes) {
    if (!states || !extremes || !extremes.darkest || !extremes.brightest) {
        throw new Error("setLcdAutoExposureStateTimes: states and exposure extremes are required.");
    }
    for (var i = 0; i < states.length; i++) {
        if (states[i].name === "auto-dark") states[i].time = extremes.darkest.time;
        if (states[i].name === "auto-bright") states[i].time = extremes.brightest.time;
    }
    return states;
}

function _lcdStateSafeName(name) {
    return String(name || "state").replace(/[^A-Za-z0-9_-]+/g, "-");
}

function _lcdStatePngIsComplete(file) {
    if (!file) return false;
    var probe = new File(file.fsName);
    if (!probe.exists || probe.length < 12) return false;
    var opened = false;
    try {
        probe.encoding = "BINARY";
        opened = probe.open("r");
        if (!opened) return false;
        if (!probe.seek(12, 2)) return false;
        var tail = probe.read(12);
        return tail.length === 12 &&
            tail.charCodeAt(4) === 73 &&
            tail.charCodeAt(5) === 69 &&
            tail.charCodeAt(6) === 78 &&
            tail.charCodeAt(7) === 68;
    } catch (_) {
        return false;
    } finally {
        if (opened) {
            try { probe.close(); } catch (_) {}
        }
    }
}

function _lcdStateWaitForPng(file, timeoutMs) {
    var deadline = new Date().getTime() + timeoutMs;
    while (new Date().getTime() < deadline) {
        if (_lcdStatePngIsComplete(file)) return true;
        $.sleep(250);
    }
    return false;
}

function _lcdStateMotionDiagnostics(masterComp, time) {
    var sceneLayer = masterComp.layer("CA GREEN");
    var sceneComp = sceneLayer.source;
    var camera = sceneComp.layer("LCD Camera");
    var transform = camera.property("ADBE Transform Group");
    var cameraOptions = camera.property("ADBE Camera Options Group");
    return {
        cameraPosition: transform.property("ADBE Position").valueAtTime(time, false),
        pointOfInterest: transform.property("ADBE Anchor Point").valueAtTime(time, false),
        orientation: transform.property("ADBE Orientation").valueAtTime(time, false),
        focusDistance: cameraOptions.property("ADBE Camera Focus Distance").valueAtTime(time, false),
        sceneScale: sceneLayer.property("Transform").property("Scale").valueAtTime(time, false)
    };
}

function renderLcdStates(masterComp, rigNull, milestone, states, previewDir) {
    if (!masterComp || !(masterComp instanceof CompItem)) {
        throw new Error("renderLcdStates: masterComp must be a CompItem.");
    }
    if (!rigNull) {
        throw new Error("renderLcdStates: rigNull is required.");
    }
    if (!states || !states.length) {
        throw new Error("renderLcdStates: at least one state is required.");
    }
    if (!previewDir || !previewDir.exists) {
        throw new Error("renderLcdStates: previewDir must exist.");
    }

    var originals = {};
    var touched = {};
    var rendered = [];
    var milestoneName = _lcdStateSafeName(String(milestone || "preview").toLowerCase());
    var s;
    var key;

    for (s = 0; s < states.length; s++) {
        var scanOverrides = states[s].overrides || {};
        for (key in scanOverrides) {
            if (!scanOverrides.hasOwnProperty(key) || touched[key]) continue;
            var scanProp = _lcdStateControlProperty(rigNull, key);
            originals[key] = scanProp.value;
            touched[key] = true;
        }
    }

    try {
        for (s = 0; s < states.length; s++) {
            var state = states[s];
            var overrides = state.overrides || {};

            for (key in originals) {
                if (!originals.hasOwnProperty(key)) continue;
                _lcdStateControlProperty(rigNull, key).setValue(originals[key]);
            }
            for (key in overrides) {
                if (!overrides.hasOwnProperty(key)) continue;
                _lcdStateControlProperty(rigNull, key).setValue(overrides[key]);
            }

            var renderTime = Number(state.time || 0);
            if (renderTime < 0) renderTime = 0;
            if (renderTime >= masterComp.duration) {
                renderTime = Math.max(0, masterComp.duration - masterComp.frameDuration);
            }

            var fileName = milestoneName + "_" + _lcdStateSafeName(state.name) + ".png";
            var outFile = new File(String(previewDir.fsName) + "/" + fileName);
            if (outFile.exists && !outFile.remove()) {
                throw new Error("Could not replace stale preview: " + outFile.fsName);
            }
            setStep("render state " + state.name);
            masterComp.saveFrameToPng(renderTime, outFile);
            if (!_lcdStateWaitForPng(outFile, 60000)) {
                throw new Error(
                    "Preview did not finish writing within 60 seconds: " +
                    outFile.fsName +
                    ". Check available disk space."
                );
            }

            var renderedState = {
                name: state.name,
                time: renderTime,
                overrides: overrides,
                output: outFile.fsName
            };
            if (state.motionDiagnostics) {
                renderedState.motion = _lcdStateMotionDiagnostics(masterComp, renderTime);
            }
            rendered.push(renderedState);
        }
    } finally {
        for (key in originals) {
            if (!originals.hasOwnProperty(key)) continue;
            try { _lcdStateControlProperty(rigNull, key).setValue(originals[key]); } catch (_) {}
        }
    }

    var report = {
        milestone: milestoneName,
        previewDir: previewDir.fsName,
        stateCount: rendered.length,
        states: rendered
    };
    setResultData("lcdStates", report);
    return report;
}
