// LCD Screen - Acceptance State Renderer
// Applies temporary control overrides, renders named PNGs, then restores every value.

function _lcdM4MotionOverrides() {
    return {
        "CAM Distance": 1900,
        "CAM Orbit": 18,
        "CAM Tilt": 7,
        "CAM Roll": 2,
        "CAM Zoom": 1500,
        "FOC Depth Of Field": 1,
        "FOC Aperture": 180,
        "FRM Auto Zoom": 1,
        "FRM Padding": 4,
        "PIX Pixel Density": 3,
        "LEN Distortion": 0,
        "LEN Chromatic Aberration": 0,
        "BLR Base Blur": 0,
        "BLR Radial Blur": 0,
        "LEN Vignette": 0,
        "LEN Grain": 0,
        "LEN Dust Strength": 0,
        "COL Tint Amount": 0,
        "COL Exposure": 1,
        "COL Auto Exposure": 0,
        "MOT Target Amount": 25,
        "MOT Target Speed": 0.18,
        "MOT Angle Amount": 0.6,
        "MOT Angle Speed": 0.12,
        "MOT Focus Amount": 220,
        "MOT Focus Speed": 0.15,
        "MOT Seed": 37
    };
}

