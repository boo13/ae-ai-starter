// LCD Screen - Macro Panel Builder

function _lcdAddPatternStripe(vectors, name, x, width, height, color) {
    var stripeGroup = vectors.addProperty("ADBE Vector Group");
    stripeGroup.name = name;
    var stripeVectors = stripeGroup.property("ADBE Vectors Group");

    var rect = stripeVectors.addProperty("ADBE Vector Shape - Rect");
    rect.property("ADBE Vector Rect Size").setValue([width, height]);
    rect.property("ADBE Vector Rect Position").setValue([x, 0]);

    var fill = stripeVectors.addProperty("ADBE Vector Graphic - Fill");
    fill.property("ADBE Vector Fill Color").setValue(color);
}

function buildSubpixelPatternComp(panelWidth, panelHeight, cfg) {
    var pitch = 12;
    var patternW = Math.min(30000, panelWidth * 2);
    var patternH = Math.min(30000, panelHeight * 2);
    var patternComp = markLcdComp(
        app.project.items.addComp(
            "LCD_SubpixelPattern",
            patternW,
            patternH,
            1,
            cfg.DURATION,
            cfg.FRAME_RATE
        )
    );
    try { patternComp.bgColor = [0, 0, 0]; } catch (_) {}

    var shape = patternComp.layers.addShape();
    shape.name = "RGB TRIPLET PATTERN";
    var root = shape.property("ADBE Root Vectors Group");
    var triplet = root.addProperty("ADBE Vector Group");
    triplet.name = "RGB Triplets";
    var vectors = triplet.property("ADBE Vectors Group");
    var startX = -patternW / 2 + pitch / 2;

    _lcdAddPatternStripe(vectors, "Red", startX - 4, 4, patternH, [1, 0.55, 0.55]);
    vectors = root.property("RGB Triplets").property("ADBE Vectors Group");
    _lcdAddPatternStripe(vectors, "Green", startX, 4, patternH, [0.55, 1, 0.55]);
    vectors = root.property("RGB Triplets").property("ADBE Vectors Group");
    _lcdAddPatternStripe(vectors, "Blue", startX + 4, 4, patternH, [0.55, 0.55, 1]);

    vectors = root.property("RGB Triplets").property("ADBE Vectors Group");
    var repeater = vectors.addProperty("ADBE Vector Filter - Repeater");
    repeater.name = "Repeat Triplets";
    repeater.property("ADBE Vector Repeater Copies").setValue(Math.ceil(patternW / pitch) + 2);
    repeater.property("ADBE Vector Repeater Transform")
        .property("ADBE Vector Repeater Position")
        .setValue([pitch, 0]);

    return {
        comp: patternComp,
        shapeLayer: shape,
        referencePitch: pitch,
        width: patternW,
        height: patternH
    };
}

function buildPanelComp(content, cfg, panelWidth, panelHeight) {
    var panelComp = markLcdComp(
        app.project.items.addComp(
            "LCD_Panel",
            panelWidth,
            panelHeight,
            1,
            cfg.DURATION,
            cfg.FRAME_RATE
        )
    );
    try { panelComp.bgColor = [0, 0, 0]; } catch (_) {}

    var contentLayer = panelComp.layers.add(content.comp);
    contentLayer.name = "SCREEN CONTENT";
    var fitScale = Math.max(panelWidth / content.width, panelHeight / content.height) * 100;
    try { contentLayer.property("Transform").property("Position").setValue([panelWidth / 2, panelHeight / 2]); } catch (_) {}
    try { contentLayer.property("Transform").property("Scale").setValue([fitScale, fitScale]); } catch (_) {}

    setStep("build live mosaic");
    var mosaic = contentLayer.property("ADBE Effect Parade").addProperty("ADBE Mosaic");
    var snappedDensity = Math.max(3, 3 * Math.round(cfg.PIXEL_DENSITY / 3));
    mosaic.property("ADBE Mosaic-0001").setValue(Math.max(1, Math.round(panelWidth / snappedDensity)));
    mosaic.property("ADBE Mosaic-0002").setValue(Math.max(1, Math.round(panelHeight / snappedDensity)));
    mosaic.property("ADBE Mosaic-0003").setValue(1);

    setStep("build live panel glow");
    addScreenGlow(contentLayer, {
        thresholdPercent: cfg.GLOW_THRESHOLD_PERCENT,
        radius: cfg.GLOW_RADIUS,
        intensity: cfg.GLOW_INTENSITY
    });
    mosaic = contentLayer.property("ADBE Effect Parade").property("ADBE Mosaic");
    var glow = contentLayer.property("ADBE Effect Parade").property("ADBE Glo2");

    setStep("build subpixel pattern");
    var pattern = buildSubpixelPatternComp(panelWidth, panelHeight, cfg);
    var patternLayers = [];
    for (var i = 0; i < 4; i++) {
        var patternLayer = panelComp.layers.add(pattern.comp);
        patternLayer.name = "RGB PATTERN " + (i + 1);
        patternLayer.blendingMode = BlendingMode.COLOR;
        patternLayer.property("Transform").property("Opacity").setValue(cfg.PIXEL_AMOUNT);
        patternLayers.push(patternLayer);
    }

    setStep("build panel tint");
    var tintLayer = addBacklightTint(panelComp, {
        color: cfg.TINT_COLOR,
        density: cfg.TINT_AMOUNT,
        preserveLuminosity: true
    });
    tintLayer.name = "PANEL TINT";
    var tintEffect = tintLayer.property("ADBE Effect Parade").property("ADBE Photo Filter");

    return {
        comp: panelComp,
        contentLayer: contentLayer,
        mosaicEffect: mosaic,
        glowEffect: glow,
        pattern: pattern,
        patternLayers: patternLayers,
        tintLayer: tintLayer,
        tintEffect: tintEffect,
        width: panelWidth,
        height: panelHeight
    };
}
