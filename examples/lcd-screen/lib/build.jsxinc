// LCD Screen - Perfect Screen v2 Build Orchestrator

function buildLcdScreen(source, rawCfg) {
    if (!source) {
        throw new Error("buildLcdScreen: source footage item is required.");
    }

    setStep("apply preset");
    var cfg = mergePreset(rawCfg);

    setStep("clean tagged v2 comps");
    var cleanup = cleanLcdScreen(app.project, cfg);

    var sceneWidth = Math.max(1, Math.round(cfg.WIDTH * cfg.SCENE_OVERSAMPLE));
    var sceneHeight = Math.max(1, Math.round(cfg.HEIGHT * cfg.SCENE_OVERSAMPLE));

    setStep("build content comp");
    var content = buildContentComp(source, cfg);

    setStep("build macro panel");
    var panel = buildPanelComp(content, cfg, sceneWidth, sceneHeight);

    setStep("build oversampled scene");
    var scene = buildSceneComp(panel, cfg);

    setStep("build live camera");
    var camera = buildCameraRig(scene.comp, scene.panelLayer, cfg);

    setStep("build master");
    var master = buildMasterComp(scene, cfg);

    setStep("build lens pass");
    var lens = buildLensStack(master.comp, cfg);

    setStep("build controls");
    var rig = buildControlRig(master.comp, cfg);

    var refs = {
        content: content,
        panel: panel,
        scene: scene,
        camera: camera,
        master: master,
        lens: lens,
        rig: rig
    };

    setStep("link live controls");
    var linkedCount = linkAllControls(master.comp, refs, cfg);
    setResultData("lcdBuild", {
        version: 2,
        marker: "ae:lcd-screen:v2",
        removedCount: cleanup.removedCount,
        compNames: [
            content.comp.name,
            panel.comp.name,
            panel.pattern.comp.name,
            scene.comp.name,
            master.comp.name
        ],
        linkedCount: linkedCount
    });

    return {
        removedCount: cleanup.removedCount,
        cleanup: cleanup,
        cfg: cfg,
        content: content,
        panel: panel,
        scene: scene,
        master: master,
        camera: camera,
        lens: lens,
        rig: rig,
        refs: refs
    };
}

/**
 * Finds a previously-built master comp by name.
 */
function findLcdMasterComp(compName) {
    for (var i = 1; i <= app.project.numItems; i++) {
        var item = app.project.item(i);
        if (item instanceof CompItem &&
            item.name === compName &&
            item.comment === "ae:lcd-screen:v2") {
            return item;
        }
    }
    return null;
}

/**
 * Freezes every expression-driven property in a comp to its current static value —
 * used before final render so playback doesn't pay for expression evaluation, and so
 * the rendered result matches whatever the live controls were last set to.
 *
 * Recurses into nested comps: most of the live controls drive properties inside
 * LCD_Panel / LCD_Screen, so a master-comp-only walk would leave them all expression-driven.
 */
function bakeAllExpressions(comp, _visited) {
    var visited = _visited || {};
    var key = "id" + comp.id;
    if (visited[key]) return 0;
    visited[key] = true;

    var count = 0;
    for (var i = 1; i <= comp.numLayers; i++) {
        var layer = comp.layer(i);
        count += _be_walkAndBake(layer);
        var src = null;
        try { src = layer.source; } catch (_) {}
        if (src && src instanceof CompItem) {
            count += bakeAllExpressions(src, visited);
        }
    }
    return count;
}

/** @private */
function _be_walkAndBake(propGroup) {
    var count = 0;
    var n;
    try { n = propGroup.numProperties; } catch (_) { return 0; }
    for (var i = 1; i <= n; i++) {
        var prop;
        try { prop = propGroup.property(i); } catch (_) { continue; }
        if (!prop) continue;
        if (prop.propertyType === PropertyType.PROPERTY) {
            if (prop.expressionEnabled) {
                try {
                    var val = prop.value;
                    prop.expressionEnabled = false;
                    prop.setValue(val);
                    count++;
                } catch (_) {}
            }
        } else {
            count += _be_walkAndBake(prop);
        }
    }
    return count;
}
