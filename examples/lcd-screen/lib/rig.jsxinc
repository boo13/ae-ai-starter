// LCD Screen - Unified Live Control Rig

function getLcdControlDefinitions(cfg) {
    return [
        { group: "Camera", name: "CAM Distance", type: "slider", value: cfg.CAMERA_DISTANCE, min: 200, max: 5000 },
        { group: "Camera", name: "CAM Orbit", type: "angle", value: cfg.CAMERA_ORBIT_DEG, min: -70, max: 70 },
        { group: "Camera", name: "CAM Tilt", type: "angle", value: cfg.CAMERA_TILT_DEG, min: -50, max: 50 },
        { group: "Camera", name: "CAM Roll", type: "angle", value: cfg.CAMERA_ROLL_DEG, min: -45, max: 45 },
        { group: "Camera", name: "CAM Zoom", type: "slider", value: cfg.CAMERA_ZOOM, min: 300, max: 6000 },

        { group: "Target", name: "TGT Target X", type: "slider", value: cfg.TARGET_X, min: -1000, max: 1000 },
        { group: "Target", name: "TGT Target Y", type: "slider", value: cfg.TARGET_Y, min: -1000, max: 1000 },

        { group: "Focus", name: "FOC Focus Offset", type: "slider", value: cfg.FOCUS_OFFSET, min: -1000, max: 1000 },
        { group: "Focus", name: "FOC Depth Of Field", type: "checkbox", value: cfg.DEPTH_OF_FIELD },
        { group: "Focus", name: "FOC Aperture", type: "slider", value: cfg.APERTURE, min: 0, max: 500 },

        { group: "Framing", name: "FRM Auto Zoom", type: "checkbox", value: cfg.AUTO_ZOOM },
        { group: "Framing", name: "FRM Padding", type: "slider", value: cfg.AUTO_ZOOM_PADDING_PERCENT, min: 0, max: 20 },

        { group: "Blur", name: "BLR Base Blur", type: "slider", value: cfg.BASE_BLUR, min: 0, max: 100 },
        { group: "Blur", name: "BLR Radial Blur", type: "slider", value: cfg.RADIAL_BLUR, min: -100, max: 100 },

        { group: "Pixels", name: "PIX Pixel Density", type: "slider", value: cfg.PIXEL_DENSITY, min: 3, max: 60 },
        { group: "Pixels", name: "PIX Pixel Amount", type: "slider", value: cfg.PIXEL_AMOUNT, min: 0, max: 100 },
        { group: "Pixels", name: "PIX Glow", type: "slider", value: cfg.GLOW_INTENSITY * 100, min: 0, max: 400 },
        { group: "Pixels", name: "PIX Glow Threshold", type: "slider", value: cfg.GLOW_THRESHOLD_PERCENT, min: 0, max: 100 },

        { group: "Lens", name: "LEN Distortion", type: "slider", value: cfg.LENS_DISTORTION_AMOUNT, min: -100, max: 100 },
        { group: "Lens", name: "LEN Chromatic Aberration", type: "slider", value: cfg.LENS_CA_AMOUNT, min: 0, max: 100 },
        { group: "Lens", name: "LEN Vignette", type: "slider", value: cfg.VIGNETTE_AMOUNT, min: 0, max: 100 },
        { group: "Lens", name: "LEN Grain", type: "slider", value: cfg.LENS_GRAIN_AMOUNT, min: 0, max: 100 },
        { group: "Lens", name: "LEN Dust Strength", type: "slider", value: cfg.DUST_STRENGTH, min: 0, max: 100 },
        { group: "Lens", name: "LEN Dust Density", type: "slider", value: cfg.DUST_DENSITY, min: 0, max: 100 },

        { group: "Color", name: "COL Tint Color", type: "color", value: [cfg.TINT_COLOR[0], cfg.TINT_COLOR[1], cfg.TINT_COLOR[2], 1] },
        { group: "Color", name: "COL Tint Amount", type: "slider", value: cfg.TINT_AMOUNT, min: 0, max: 100 },
        { group: "Color", name: "COL Exposure", type: "slider", value: cfg.EXPOSURE, min: -5, max: 5 },
        { group: "Color", name: "COL Auto Exposure", type: "checkbox", value: cfg.AUTO_EXPOSURE },

        { group: "Motion", name: "MOT Target Amount", type: "slider", value: cfg.MOTION_TARGET_AMOUNT, min: 0, max: 60 },
        { group: "Motion", name: "MOT Target Speed", type: "slider", value: cfg.MOTION_TARGET_SPEED, min: 0, max: 1.5 },
        { group: "Motion", name: "MOT Angle Amount", type: "slider", value: cfg.MOTION_ANGLE_AMOUNT, min: 0, max: 3 },
        { group: "Motion", name: "MOT Angle Speed", type: "slider", value: cfg.MOTION_ANGLE_SPEED, min: 0, max: 1.5 },
        { group: "Motion", name: "MOT Focus Amount", type: "slider", value: cfg.MOTION_FOCUS_AMOUNT, min: 0, max: 250 },
        { group: "Motion", name: "MOT Focus Speed", type: "slider", value: cfg.MOTION_FOCUS_SPEED, min: 0, max: 1.5 },
        { group: "Motion", name: "MOT Seed", type: "slider", value: cfg.MOTION_SEED, min: 1, max: 10000 },

        { group: "Quality", name: "QUAL Level", type: "slider", value: cfg.QUALITY_LEVEL, min: 0, max: 2 }
    ];
}

function buildControlRig(masterComp, cfg) {
    setStep("build unified controls");
    var definitions = getLcdControlDefinitions(cfg);
    var controls = [];
    for (var i = 0; i < definitions.length; i++) {
        controls.push({
            name: definitions[i].name,
            type: definitions[i].type,
            value: definitions[i].value
        });
    }

    var rig = addExpressionRig(masterComp, {
        nullName: "LCD CONTROLS",
        controls: controls
    });
    try { rig["null"].shy = true; } catch (_) {}
    return {
        "null": rig["null"],
        controls: rig.controls,
        definitions: definitions
    };
}

function findLcdControlsNull(masterComp, nullName) {
    if (!masterComp) return null;
    try { return masterComp.layer(nullName || "LCD CONTROLS"); } catch (_) { return null; }
}
