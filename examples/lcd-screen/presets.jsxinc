function getLcdPresetNames() {
    var names = [];
    for (var i = 0; i < LcdScreenPresetOrder.length; i++) {
        names.push(LcdScreenPresetOrder[i]);
    }
    return names;
}

function getLcdPresetValues(presetName) {
    if (!LcdScreenPresets.hasOwnProperty(presetName)) {
        throw new Error("Unknown LCD preset: " + presetName);
    }
    var values = {};
    var key;
    for (key in LcdScreenPresetBase) {
        if (LcdScreenPresetBase.hasOwnProperty(key)) values[key] = LcdScreenPresetBase[key];
    }
    var overrides = LcdScreenPresets[presetName];
    for (key in overrides) {
        if (overrides.hasOwnProperty(key)) values[key] = overrides[key];
    }
    return values;
}

function _lcdPresetControlProperty(rigNull, controlName) {
    var effect = rigNull.property("ADBE Effect Parade").property(controlName);
    if (!effect) throw new Error("LCD preset control not found: " + controlName);
    var prop = effect.property(1);
    if (!prop || prop.propertyType !== PropertyType.PROPERTY) {
        throw new Error("LCD preset control has no value property: " + controlName);
    }
    return prop;
}

function _lcdPresetCompCount() {
    var count = 0;
    if (!app.project) return count;
    for (var i = 1; i <= app.project.numItems; i++) {
        if (app.project.item(i) instanceof CompItem) count++;
    }
    return count;
}

function applyPreset(presetName, rigNull) {
    var targetRig = rigNull;
    if (!targetRig) {
        var master = findLcdMasterComp(LcdScreenConfig.MASTER_COMP_NAME);
        if (!master) throw new Error("Build the LCD Screen before applying a preset.");
        targetRig = findLcdControlsNull(master);
    }
    if (!targetRig) throw new Error("LCD CONTROLS null was not found.");

    var values = getLcdPresetValues(presetName);
    var beforeCount = _lcdPresetCompCount();
    var applied = 0;
    for (var key in values) {
        if (!values.hasOwnProperty(key)) continue;
        _lcdPresetControlProperty(targetRig, key).setValue(values[key]);
        applied++;
    }
    var afterCount = _lcdPresetCompCount();
    var report = {
        name: presetName,
        intent: LcdScreenPresetIntents[presetName],
        appliedControlCount: applied,
        compCountBefore: beforeCount,
        compCountAfter: afterCount,
        createdCompCount: afterCount - beforeCount,
        values: values
    };
    setResultData("lcdPreset", report);
    return report;
}

function mergePreset(baseCfg) {
    var merged = {};
    for (var key in baseCfg) {
        if (baseCfg.hasOwnProperty(key)) merged[key] = baseCfg[key];
    }
    return merged;
}
