// LCD Screen — Presets
// Partial overrides merged over LcdScreenConfig by mergePreset(). The first 11 match
// ProductionCrate Perfect Screen's own named presets (the only 11 of its 20 that are
// publicly documented); the last 5 are original presets that exercise the physical-panel
// half of the feature set Perfect Screen doesn't attempt.

var LcdScreenPresets = {
    "Static Default": {},

    "Static Tinted": {
        BACKLIGHT_TINT_PRESET: "warm",
        BACKLIGHT_TINT_DENSITY: 35
    },

    "Reading Front": {
        CAMERA_ORBIT_DEG: 0, CAMERA_TILT_DEG: 0, CAMERA_DISTANCE: 1200, APERTURE: 20,
        MOTION_TARGET_AMOUNT: 40, MOTION_TARGET_SPEED: 0.08
    },

    "Reading Move": {
        CAMERA_ORBIT_DEG: 4,
        MOTION_TARGET_AMOUNT: 80, MOTION_TARGET_SPEED: 0.06,
        MOTION_FOCUS_AMOUNT: 20, MOTION_FOCUS_SPEED: 0.1
    },

    "Reading Angle": {
        CAMERA_ORBIT_DEG: 18, CAMERA_TILT_DEG: 10,
        MOTION_TARGET_AMOUNT: 50, MOTION_TARGET_SPEED: 0.07
    },

    "Reading Tilted": {
        CAMERA_ORBIT_DEG: 22, CAMERA_TILT_DEG: 16,
        VIEWING_ANGLE_AMOUNT: 55, MOTION_TARGET_AMOUNT: 40
    },

    "Side Focus Pull": {
        CAMERA_ORBIT_DEG: 30, APERTURE: 60,
        MOTION_FOCUS_AMOUNT: 120, MOTION_FOCUS_SPEED: 0.05
    },

    "Close Up Low": {
        CAMERA_DISTANCE: 700, CAMERA_TILT_DEG: -8, APERTURE: 70,
        SUBPIXEL_AMOUNT: 75, SUBPIXEL_PIXEL_SIZE: 10
    },

    "Sideways": {
        CAMERA_ORBIT_DEG: 45,
        VIEWING_ANGLE_AMOUNT: 65, LENS_CA_AMOUNT: 40
    },

    "Pan Down": {
        CAMERA_TILT_DEG: -20,
        MOTION_ANGLE_AMOUNT: 6, MOTION_ANGLE_SPEED: 0.05
    },

    "Orbit Wides": {
        CAMERA_DISTANCE: 2200, CAMERA_ORBIT_DEG: 20, CAMERA_ZOOM: 1400,
        MOTION_ANGLE_AMOUNT: 10, MOTION_ANGLE_SPEED: 0.04,
        AMBIENT_SPILL_OPACITY: 40
    },

    // --- Originals: exercise the physical-panel half Perfect Screen doesn't attempt ---

    "Retro LCD": {
        SUBPIXEL_MODE: "stripe", SUBPIXEL_PIXEL_SIZE: 9,
        SCANLINE_AMOUNT: 55, SCANLINE_ROLL_BAR: true,
        BACKLIGHT_TINT_PRESET: "green", GLOW_INTENSITY: 1.4
    },

    "OLED Night": {
        BACKLIGHT_TINT_PRESET: "cool",
        BACKLIGHT_BLEED_INTENSITY: 0, BACKLIGHT_MURA: 0,
        VIGNETTE_AMOUNT: 55, GLOW_INTENSITY: 1.6, GLOW_THRESHOLD_PERCENT: 45
    },

    "Desk Setup": {
        BEZEL_WIDTH: 50, BEZEL_CORNER_RADIUS: 12,
        AMBIENT_SPILL_ENABLED: true, AMBIENT_SPILL_OPACITY: 45,
        CAMERA_TILT_DEG: 10, GLASS_DUST: 35, GLASS_SMUDGE: 25
    },

    "Kiosk": {
        CAMERA_DISTANCE: 1000, CAMERA_ORBIT_DEG: 0, CAMERA_TILT_DEG: 0,
        GLASS_SMUDGE: 45, GLASS_DUST: 40, VIGNETTE_AMOUNT: 20
    },

    "Screen Off": {
        GLOW_INTENSITY: 0, SUBPIXEL_AMOUNT: 10, SCANLINE_AMOUNT: 10,
        BACKLIGHT_BLEED_INTENSITY: 0, BACKLIGHT_MURA: 0,
        GLASS_SHEEN: 40, VIGNETTE_AMOUNT: 45
    }
};

/**
 * Returns a shallow-copied config with the named preset's overrides merged in.
 * baseCfg.PRESET selects the preset; "" or an unknown name leaves baseCfg untouched.
 */
function mergePreset(baseCfg) {
    var merged = {};
    for (var k in baseCfg) { if (baseCfg.hasOwnProperty(k)) merged[k] = baseCfg[k]; }

    var presetName = baseCfg.PRESET;
    if (presetName && LcdScreenPresets.hasOwnProperty(presetName)) {
        var overrides = LcdScreenPresets[presetName];
        for (var k2 in overrides) { if (overrides.hasOwnProperty(k2)) merged[k2] = overrides[k2]; }
    }
    return merged;
}
