  {
    "name": "sampleImage",
    "object": "Layer",
    "signature": "thisLayer.sampleImage(point[, radius=[0.5, 0.5]][, postEffect=true][, t=time])",
    "params": [
      {
        "name": "point",
        "type": "2-dimensional Number array",
        "description": "Required. The point at which to sample, im layer space. The point [0, 0] is the center of the upper-left pixel in the layer.",
        "optional": false
      },
      {
        "name": "radius",
        "type": "2-dimensional Number array",
        "description": "Optional. Specifies the horizontal and vertical distance from the sample center to the edges of the sampled rectangle. The default value samples one pixel. Defaults to [0.5, 0.5].",
        "optional": true
      },
      {
        "name": "0.5",
        "type": "unknown",
        "description": "",
        "optional": false
      },
      {
        "name": "postEffect",
        "type": "Boolean",
        "description": "Optional. If true, to sample the values after layer masks and effects directly applied to the layer have been rendered. If false, sample values before layer masks and effects. Defaults to true.",
        "optional": true
      },
      {
        "name": "t",
        "type": "Number",
        "description": "Optional. Defaults to time.",
        "optional": true
      }
    ],
    "returns": "unspecified",
    "appliesTo": [
      "Layer"
    ],
    "minVersion": null,
    "example": "thisComp.layer(1).sampleImage([100, 100], [2, 1.5])",
    "probe": "thisLayer.sampleImage([100, 100], [1, 1], true, time)",
    "pitfalls": [
      "Samples the layer render buffer and does not include adjustment layers above it."
    ],
    "keywords": [
      "sampleimage",
      "layer",
      "samples",
      "color",
      "alpha",
      "channel",
      "values",
      "returns",
      "average",
      "alpha-weighted",
      "value",
      "pixels"
    ],
    "source": "docsforadobe/after-effects-expression-reference@a5c5c5066d0395239d524510ace060963f5c0d33:docs/layer/general.md",
    "verifiedAEVersion": null,
    "verifiedEngines": [],
    "verifiedStatus": "docs-sourced"
  },
  {
    "name": "sourceRectAtTime",
    "object": "Layer",
    "signature": "thisLayer.sourceRectAtTime(t = time, includeExtents = false)",
    "params": [
      {
        "name": "t",
        "type": "Number",
        "description": "Optional. The specified time (in comp seconds) to apply the smoothing filter to. Defaults to time (the current comp time, in seconds).",
        "optional": true
      },
      {
        "name": "includeExtents",
        "type": "Boolean",
        "description": "Optional. Only applies to shape layers and paragraph text layers. Defaults to false.",
        "optional": true
      }
    ],
    "returns": "An object with four attributes: {top, left, width, height}",
    "appliesTo": [
      "Layer"
    ],
    "minVersion": "13.2",
    "example": "myTextLayer.sourceRectAtTime().width",
    "probe": "thisComp.layer(\"Expression verification\").sourceRectAtTime().width",
    "pitfalls": [
