    "name": "seedRandom",
    "object": "global",
    "signature": "seedRandom(offset[, timeless=false])",
    "params": [
      {
        "name": "offset",
        "type": "Number",
        "description": "The value with which to offset the seed. This is also used to control the initial value of the wiggle() function.",
        "optional": false
      },
      {
        "name": "timeless",
        "type": "Boolean",
        "description": "Optional. Use true for the timeless argument to not use the current time as input to the random seed. This allows you to generate a random number that doesn't vary depending on the time of evaluation. Defaults to false.",
        "optional": true
      }
    ],
    "returns": "None",
    "appliesTo": [
      "all expression properties"
    ],
    "minVersion": null,
    "example": "seedRandom(123456, true);\nrandom()*100",
    "pitfalls": [
      "Pass timeless=true for static random values; otherwise results vary with time."
