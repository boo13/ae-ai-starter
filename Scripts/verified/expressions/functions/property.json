  {
    "name": "loopIn",
    "object": "Property",
    "signature": "thisLayer.position.loopIn([type=\"cycle\"][, numKeyframes=0])",
    "params": [
      {
        "name": "type",
        "type": "Predefined string as defined in Loop Types",
        "description": "Optional. The loop type to use. Defaults to \"cycle\"",
        "optional": true
      },
      {
        "name": "numKeyframes",
        "type": "Number",
        "description": "Optional. The segment to loop, from keyframe #1 to keyframe #numKeyframes + 1. If unspecified (or 0), all keyframes loop. Defaults to 0.",
        "optional": true
      }
    ],
    "returns": "A looped value of the same property type as this current property.",
    "appliesTo": [
      "Property"
    ],
    "minVersion": null,
    "example": "loopIn(\"cycle\", 3);",
    "pitfalls": [
      "Requires at least two keyframes on the property."
