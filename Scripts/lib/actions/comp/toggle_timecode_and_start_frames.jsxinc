/**
 * @name Toggle Timecode And Start Frames
 * @description Sets the project frame count mode to start on frame 0 or 1 and normalizes comp displayStartFrame to 0.
 * @category comp
 * @tier block
 * @inputs opts: { startAtOne: boolean (default true) }
 * @outputs boolean — true when frame count starts at 1, false when it starts at 0
 * @whenToUse You want a project-wide frame numbering convention switch without opening preferences.
 * @example toggleTimecodeAndStartFrames({ startAtOne: true });
 */
function toggleTimecodeAndStartFrames(opts) {
    if (!app.project) throw new Error("Toggle Timecode And Start Frames: no project is open.");
    var o = opts || {};
    var startAtOne = (o.startAtOne !== false);
    var i = 0;
    setStep("toggle frames count type");
    app.project.framesCountType = startAtOne ? FramesCountType.FC_START_1 : FramesCountType.FC_START_0;
    for (i = app.project.numItems; i > 0; i--) {
        var item = app.project.items[i];
        if (item instanceof CompItem) item.displayStartFrame = 0;
    }
    return startAtOne;
}
