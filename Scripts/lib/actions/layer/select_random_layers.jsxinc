/**
 * @name Select Random Layers
 * @description Randomly selects unlocked layers in the comp using a threshold probability.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { threshold: number (default 0.5), clearSelection: boolean (default true) }
 * @outputs number — count of layers selected
 * @whenToUse You want a quick random subset of layers for experimentation or staggered operations.
 * @example var count = selectRandomLayers(comp, { threshold: 0.25 });
 */
function selectRandomLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Select Random Layers: comp must be a CompItem.");
    var o = opts || {};
    var threshold = (o.threshold !== undefined) ? Number(o.threshold) : 0.5;
    var clearSelection = (o.clearSelection !== false);
    var total = 0;
    var i = 0;
    if (isNaN(threshold) || threshold < 0 || threshold > 1) throw new Error("Select Random Layers: opts.threshold must be between 0 and 1.");
    setStep("select random layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (clearSelection) layer.selected = false;
        if (!layer.locked && Math.random() > threshold) {
            layer.selected = true;
            total += 1;
        }
    }
    return total;
}
