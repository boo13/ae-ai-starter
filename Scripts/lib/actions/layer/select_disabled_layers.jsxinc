/**
 * @name Select Disabled Layers
 * @description Selects all unlocked disabled layers in the comp.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { clearSelection: boolean (default true) }
 * @outputs number — count of layers selected
 * @whenToUse You want to quickly find hidden layers that are disabled via the eyeball switch.
 * @example var count = selectDisabledLayers(comp);
 */
function selectDisabledLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Select Disabled Layers: comp must be a CompItem.");
    var o = opts || {};
    var clearSelection = (o.clearSelection !== false);
    var total = 0;
    var i = 0;
    setStep("select disabled layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (clearSelection) layer.selected = false;
        if (!layer.locked && !layer.enabled) {
            layer.selected = true;
            total += 1;
        }
    }
    return total;
}
