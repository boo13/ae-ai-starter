/**
 * @name Select Guide Layers
 * @description Selects all guide layers in the comp.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { clearSelection: boolean (default true) }
 * @outputs number — count of guide layers selected
 * @whenToUse You want to isolate guide layers for cleanup or editing.
 * @example var count = selectGuideLayers(comp);
 */
function selectGuideLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Select Guide Layers: comp must be a CompItem.");
    var o = opts || {};
    var clearSelection = (o.clearSelection !== false);
    var total = 0;
    var i = 0;
    setStep("select guide layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (clearSelection) layer.selected = false;
        if (layer.guideLayer) {
            layer.selected = true;
            total += 1;
        }
    }
    return total;
}
