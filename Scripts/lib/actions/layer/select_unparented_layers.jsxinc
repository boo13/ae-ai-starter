/**
 * @name Select Unparented Layers
 * @description Selects all unlocked layers in the comp that do not have a parent.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { clearSelection: boolean (default true) }
 * @outputs number — count of layers selected
 * @whenToUse You want to find loose layers that are not attached to any rig or hierarchy.
 * @example var count = selectUnparentedLayers(comp);
 */
function selectUnparentedLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Select Unparented Layers: comp must be a CompItem.");
    var o = opts || {};
    var clearSelection = (o.clearSelection !== false);
    var total = 0;
    var i = 0;
    setStep("select unparented layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (clearSelection) layer.selected = false;
        if (!layer.locked && layer.parent === null) {
            layer.selected = true;
            total += 1;
        }
    }
    return total;
}
