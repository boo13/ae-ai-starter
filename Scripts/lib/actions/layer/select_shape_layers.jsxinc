/**
 * @name Select Shape Layers
 * @description Selects all shape layers in the comp, unlocking them first if requested.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { unlockLayers: boolean (default true), clearSelection: boolean (default true) }
 * @outputs number — count of shape layers selected
 * @whenToUse You want to isolate shape layers for styling or animation changes.
 * @example var count = selectShapeLayers(comp);
 */
function selectShapeLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Select Shape Layers: comp must be a CompItem.");
    var o = opts || {};
    var unlockLayers = (o.unlockLayers !== false);
    var clearSelection = (o.clearSelection !== false);
    var total = 0;
    var i = 0;
    setStep("select shape layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (unlockLayers) layer.locked = false;
        if (clearSelection) layer.selected = false;
        if (layer instanceof ShapeLayer) {
            layer.selected = true;
            total += 1;
        }
    }
    return total;
}
