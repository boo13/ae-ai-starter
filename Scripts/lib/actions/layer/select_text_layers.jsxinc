/**
 * @name Select Text Layers
 * @description Selects all text layers in the comp. Optionally unlocks layers first so locked text layers can be selected as well.
 * @category layer
 * @tier block
 * @inputs comp: CompItem; opts: { unlockLayers: boolean (default true), clearSelection: boolean (default true) }
 * @outputs number — count of text layers selected
 * @whenToUse You want to isolate all text layers in a comp for batch styling, parenting, or cleanup.
 * @example var count = selectTextLayers(comp);
 */
function selectTextLayers(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) {
        throw new Error("Select Text Layers: comp must be a CompItem.");
    }

    var o = opts || {};
    var unlockLayers = (o.unlockLayers !== false);
    var clearSelection = (o.clearSelection !== false);
    var count = 0;
    var i = 0;

    setStep("iterate layers");
    for (i = comp.numLayers; i > 0; i--) {
        var layer = comp.layer(i);
        if (unlockLayers) {
            layer.locked = false;
        }
        if (clearSelection) {
            layer.selected = false;
        }
        if (layer instanceof TextLayer) {
            layer.selected = true;
            count++;
        }
    }

    return count;
}
