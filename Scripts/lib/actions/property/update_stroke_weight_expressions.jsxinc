/**
 * @name Update Stroke Weight Expressions
 * @description Replaces an older maintain-stroke-width expression with the newer safer expression across the whole project.
 * @category property
 * @tier block
 * @inputs opts: { oldExpression: string (optional), newExpression: string (optional) }
 * @outputs number — count of expressions replaced
 * @whenToUse You want to normalize old stroke-weight maintenance expressions to the safer project-wide variant.
 * @example var count = updateStrokeWeightExpressions({});
 */

/**
 * Recursively scans properties and replaces matching expressions.
 * @private
 */
function _uswe_walk(group, oldExpr, newExpr) {
    var count = 0;
    var i = 0;
    for (i = 1; i <= group.numProperties; i++) {
        var prop = group.property(i);
        if (prop.propertyType === PropertyType.PROPERTY) {
            if (prop.canSetExpression && prop.expressionEnabled) {
                var current = String(prop.expression || "").replace(/\s+/g, "");
                if (current === oldExpr) {
                    prop.expression = newExpr;
                    count += 1;
                }
            }
        } else if (prop.propertyType === PropertyType.INDEXED_GROUP || prop.propertyType === PropertyType.NAMED_GROUP) {
            count += _uswe_walk(prop, oldExpr, newExpr);
        }
    }
    return count;
}

function updateStrokeWeightExpressions(opts) {
    if (!app.project) {
        throw new Error("Update Stroke Weight Expressions: no project is open.");
    }
    var o = opts || {};
    var oldExpr = String(o.oldExpression || "value / length(toComp([0,0]), toComp([0.7071,0.7071])) || 0.001;").replace(/\s+/g, "");
    var newExpr = String(o.newExpression || "s = length(toComp([0,0]),toComp([0.7071,0.7071])); (s) ? value / s : 0;");
    var total = 0;
    var i = 0;

    setStep("update stroke expressions");
    for (i = 1; i <= app.project.numItems; i++) {
        var item = app.project.item(i);
        if (item instanceof CompItem) {
            var l = 0;
            for (l = item.numLayers; l > 0; l--) {
                total += _uswe_walk(item.layer(l), oldExpr, newExpr);
            }
        }
    }
    return total;
}
