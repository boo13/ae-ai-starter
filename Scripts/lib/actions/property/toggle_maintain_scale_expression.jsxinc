/**
 * @name Toggle Maintain Scale Expression
 * @description Toggles an expression on selected 3D layers so their apparent scale stays visually consistent as Z position changes.
 * @category property
 * @tier block
 * @inputs comp: CompItem; opts: { layers: AVLayer[] (default comp.selectedLayers) }
 * @outputs number — count of layers updated
 * @whenToUse You want 3D layers to preserve their apparent screen scale while moving in Z space.
 * @example var count = toggleMaintainScaleExpression(comp);
 */
function toggleMaintainScaleExpression(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) {
        throw new Error("Toggle Maintain Scale Expression: comp must be a CompItem.");
    }
    var o = opts || {};
    var layers = o.layers || comp.selectedLayers;
    var expression = "var zoom = (thisComp.activeCamera) ? thisComp.activeCamera.cameraOption.zoom : thisComp.width / 0.72; value * (1 + (transform.position[2] / zoom));";
    var total = 0;
    var i = 0;

    if (!layers || !layers.length) {
        throw new Error("Toggle Maintain Scale Expression: no layers selected.");
    }

    setStep("toggle maintain scale");
    for (i = 0; i < layers.length; i++) {
        var layer = layers[i];
        if (!layer.threeDLayer) continue;
        var scaleProp = layer.transform.scale;
        if (scaleProp.expression && scaleProp.expression.length > 0) {
            var scaleValue = scaleProp.value;
            scaleProp.expression = "";
            scaleProp.setValue(scaleValue);
        } else {
            var current = scaleProp.value[0];
            var z = layer.transform.position.value[2];
            var zoom = layer.containingComp.activeCamera ? layer.containingComp.activeCamera.cameraOption.zoom.value : (layer.containingComp.width / 0.72);
            var adjusted = current / (1 + (z / zoom));
            scaleProp.setValue([adjusted, adjusted, adjusted]);
            scaleProp.expression = expression;
        }
        total += 1;
    }
    return total;
}
