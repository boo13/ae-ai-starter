/**
 * @name Add Markers At Selected Keyframes
 * @description Adds a layer marker at the time of each selected keyframe on the selected properties. Each selected keyframe becomes a marker on its owning layer.
 * @category marker
 * @tier block
 * @inputs comp: CompItem; opts: { properties: Property[] (default comp.selectedProperties), comment: string (default "") }
 * @outputs number — count of markers added to layers
 * @whenToUse You want layer markers aligned to specific selected animation beats without placing them by hand.
 * @example var count = addMarkersAtSelectedKeyframes(comp, { comment: "Beat" });
 */

/**
 * Walks up the property chain until it reaches the owning layer.
 * @private
 */
function _mask_getOwningLayer(prop) {
    while (prop && prop.parentProperty !== null) {
        prop = prop.parentProperty;
    }
    return prop;
}

function addMarkersAtSelectedKeyframes(comp, opts) {
    if (!comp || !(comp instanceof CompItem)) {
        throw new Error("Add Markers At Selected Keyframes: comp must be a CompItem.");
    }

    var o = opts || {};
    var properties = o.properties || comp.selectedProperties;
    var comment = (o.comment !== undefined && o.comment !== null) ? String(o.comment) : "";
    var marker = new MarkerValue(comment);
    var count = 0;
    var i = 0;
    var k = 0;

    setStep("validate properties");
    if (!properties || !properties.length) {
        throw new Error("Add Markers At Selected Keyframes: no properties selected.");
    }

    setStep("add markers at keyframes");
    for (i = 0; i < properties.length; i++) {
        var prop = properties[i];
        if (!prop || prop.propertyType !== PropertyType.PROPERTY || !prop.selectedKeys || !prop.selectedKeys.length) {
            continue;
        }
        var layer = _mask_getOwningLayer(prop);
        if (!layer || !layer.marker) {
            continue;
        }
        for (k = 0; k < prop.selectedKeys.length; k++) {
            layer.marker.setValueAtTime(prop.keyTime(prop.selectedKeys[k]), marker);
            count++;
        }
    }

    if (!count) {
        throw new Error("Add Markers At Selected Keyframes: no selected keyframes were found on marker-capable layers.");
    }

    return count;
}
