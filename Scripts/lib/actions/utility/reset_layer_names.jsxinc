/**
 * @name Reset Layer Names
 * @description Resets every layer name in the comp back to AE's default-derived name by assigning an empty string.
 * @category utility
 * @tier block
 * @inputs comp: CompItem
 * @outputs number — count of layer names reset
 * @whenToUse You want to clear custom naming in a comp and fall back to source/default layer names.
 * @example var count = resetLayerNames(comp);
 */
function resetLayerNames(comp) {
    if (!comp || !(comp instanceof CompItem)) throw new Error("Reset Layer Names: comp must be a CompItem.");
    var total = 0;
    var i = 0;
    setStep("reset layer names");
    for (i = comp.numLayers; i > 0; i--) {
        comp.layer(i).name = "";
        total += 1;
    }
    return total;
}
